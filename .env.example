# Salon POS Environment Configuration Template
# Copy this file to '.env' and fill in the values for your environment.

# 1. Backend API Base URL
VITE_API_BASE_URL=
VITE_API_URL=

# For Local Backend Development:
# VITE_BACKEND_TARGET=http://127.0.0.1:8000

# 2. Public Customer-Facing Web URL (salora-web / Share_web)
VITE_PUBLIC_WEB_URL=http://localhost:3000
